# Copy this file to .env and fill it in. It's loaded automatically (via
# python-dotenv, see config.py) whenever the script runs - no need to
# `source` it or export anything by hand. A variable already exported in
# your actual shell environment (or set in a launchd plist) still takes
# priority over this file, if you'd rather manage it that way instead.

# Required: create your own app on https://ibroadcast.com ("Developer"
# section at the bottom of the account page) to get a client_id with the
# account:read / upload / library:read / library:write scopes.
IBROADCAST_CLIENT_ID=

# Optional: must match EXACTLY the "Redirect URI" configured for your app
# on ibroadcast.com (scheme, host, port, path). Only change this if you
# chose a different port or path when creating the app.
# IBROADCAST_REDIRECT_URI=http://localhost:8912/callback

# Optional: where to store the MD5 cache / token / dump / failures log.
# Defaults to the data/ folder at the project root.
# IBROADCAST_DATA_DIR=/path/to/folder
